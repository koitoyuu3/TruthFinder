@startuml
!pragma teoz true

title Agent-Enabled Verifiable Semantic Oracle Workflow

hide footbox
autonumber

skinparam backgroundColor white
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 15
skinparam BoxPadding 6
skinparam ArrowThickness 2
skinparam RoundCorner 6
skinparam SequenceBoxBackgroundColor white
skinparam SequenceBoxBorderColor #555555
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #555555
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor #555555
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #555555
skinparam MaxMessageSize 400

skinparam DefaultFontSize 28
skinparam SequenceGroupFontSize 28
skinparam SequenceTitleFontSize 32
skinparam ParticipantFontSize 26
skinparam NoteFontSize 26
skinparam SequenceMessageFontSize 26
skinparam SequenceBoxFontSize 26
skinparam SequenceDividerFontSize 26

box "On-chain"
participant "UserContract" as UC
participant "OracleContract" as OC
end box

box "Off-chain"
participant "OracleNetwork" as Net
participant "OracleNode" as Ag
participant "TruthDiscovery" as TD
participant "ZKProver" as ZK
end box

== Query Phase ==

UC -> OC : submit query
activate OC
OC -> OC : record & emit event
OC --> Net : query event
activate Net

== Evidence Collection  //[same flow on nodes 1...n]// ==

Net -> Ag : dispatch query
activate Ag
Ag -> Ag : RetrieveEvidence
Ag -> Ag : ExtractClaims
Ag --> Net : claim report
deactivate Ag

== Truth Discovery ==

Net -> TD : claim reports
activate TD
TD -> TD : Aggregate
TD --> Net : result + reliabilities
deactivate TD

== ZK Proof ==

Net -> ZK : GenerateProof
activate ZK
ZK -> ZK : encode as Circom circuit
ZK -> ZK : construct witness
ZK --> Net : proof
deactivate ZK

== On-chain Verification ==

Net -> OC : result + proof
OC -> OC : VerifyProof
alt success
OC -> OC : store results
OC --> UC : output available
else failure
OC --> Net : reject
end
deactivate OC
deactivate Net
@enduml
