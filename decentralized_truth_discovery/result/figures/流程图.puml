@startuml
!pragma teoz true

title Agent-Enabled Verifiable Semantic Oracle Workflow

hide footbox
autonumber

skinparam backgroundColor white
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 30
skinparam BoxPadding 12
skinparam ArrowThickness 1
skinparam RoundCorner 6
skinparam SequenceBoxBackgroundColor white
skinparam SequenceBoxBorderColor #555555
skinparam SequenceGroupBodyBackgroundColor white
skinparam SequenceGroupBorderColor #555555
skinparam ParticipantBackgroundColor white
skinparam ParticipantBorderColor #555555
skinparam NoteBackgroundColor white
skinparam NoteBorderColor #555555
skinparam SequenceMessageAlignment center
skinparam MaxMessageSize 200

box "On-chain Domain"
participant "User Contract" as UC
participant "Oracle Contract" as OC
end box

box "Off-chain Domain"
participant "Oracle Network" as Network
participant "Oracle Node\n(Autonomous Agent)" as Agent
participant "Truth Discovery" as TD
participant "ZKP Prover" as Prover
end box

group Query submission and event emission
UC -> OC : submit oracle query
activate OC
OC -> OC : record query metadata and emit event
OC --> Network : notify query event
end

activate Network

group Parallel agent evidence collection (for each oracle node n)
par
note over Network, Agent #FFFFFF: **Agent 1**
Network -> Agent : dispatch query
activate Agent
Agent -> Agent : RetrieveEvidence
Agent -> Agent : AgentExtractClaims
Agent --> Network : return claim report
deactivate Agent
else
note over Network, Agent #FFFFFF: **Agent 2**
Network -> Agent : dispatch query
activate Agent
Agent -> Agent : RetrieveEvidence
Agent -> Agent : AgentExtractClaims
Agent --> Network : return claim report
deactivate Agent
else
note over Network, Agent #FFFFFF: **Agent n**
Network -> Agent : dispatch query
activate Agent
Agent -> Agent : RetrieveEvidence
Agent -> Agent : AgentExtractClaims
Agent --> Network : return claim report
deactivate Agent
end
end

group Robust truth discovery aggregation
Network -> TD : submit heterogeneous claim reports
activate TD
TD -> TD : build TF-IDF vocabulary over textual claims
TD -> TD : TruthDiscoveryAggregate
TD --> Network : output aggregated result and node reliabilities
deactivate TD
end

group Zero-knowledge proof generation
Network -> Prover : GenerateProof
activate Prover
Prover -> Prover : encode truth discovery pipeline as Circom circuit
Prover -> Prover : construct witness from per-node reports\nand intermediate states
Prover --> Network : return proof
deactivate Prover
end

group On-chain submission and verification
Network -> OC : reporter submits aggregated result and proof
OC -> OC : VerifyProof
alt verification succeeds
OC -> OC : store finalized claim-level results
OC --> UC : finalized semantic output available
else verification fails
OC --> Network : reject submission
end
deactivate OC
end

deactivate Network
@enduml
